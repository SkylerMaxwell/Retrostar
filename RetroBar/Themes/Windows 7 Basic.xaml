<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Windows 7 Basic. Until measured Windows 7 taskbar images are supplied, this theme is the Windows Vista Basic
        taskbar exactly, with nothing redefined here. The Windows 7 Basic look is to be built in this file, on top of
        Vista Basic's, from those images.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Windows Vista Basic.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
