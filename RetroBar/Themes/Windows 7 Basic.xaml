<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Windows 7 Basic: Vista Basic's opaque taskbar with the Windows 7 superbar. Windows Vista Basic is merged last,
        so its opaque brushes take precedence over the Aero ones that Windows 7 Aero brings in.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Windows 7 Aero.xaml" />
        <ResourceDictionary Source="Windows Vista Basic.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
