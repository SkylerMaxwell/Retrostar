<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!--
        Windows 7 Basic: the opaque look Windows 7 used without desktop composition. The layout is Windows 7 Aero's;
        only the colours differ, and they are the same ones Windows 7 Aero switches to while Aero glass is off.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Windows 7 Aero.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <system:Boolean x:Key="AllowsTransparency">False</system:Boolean>

    <SolidColorBrush x:Key="TaskbarWindowBackground" Color="#A6BFDB" />
    <SolidColorBrush x:Key="TaskbarBackground" Color="#A6BFDB" />
    <SolidColorBrush x:Key="TaskbarVerticalBackground" Color="#A6BFDB" />
    <SolidColorBrush x:Key="TaskbarTopBorder" Color="#434B55" />
    <SolidColorBrush x:Key="TaskbarTopInnerBorder" Color="#CBD9E7" />

    <SolidColorBrush x:Key="ClockForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputLanguageForeground" Color="#000000" />
    <SolidColorBrush x:Key="TrayToggleArrowForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ShowDesktopOuterBorder" Color="#505962" />
    <SolidColorBrush x:Key="ShowDesktopInnerBorder" Color="#8893A2" />
    <LinearGradientBrush x:Key="ShowDesktopBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#737C8F" Offset="0.0" />
        <GradientStop Color="#737C8F" Offset="0.10" />
        <GradientStop Color="#5A6779" Offset="0.11" />
        <GradientStop Color="#5A6779" Offset="0.72" />
        <GradientStop Color="#5D7986" Offset="0.73" />
        <GradientStop Color="#5D7986" Offset="0.80" />
        <GradientStop Color="#737C8F" Offset="0.81" />
        <GradientStop Color="#737C8F" Offset="0.93" />
        <GradientStop Color="#8093A9" Offset="0.94" />
        <GradientStop Color="#8093A9" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShowDesktopBackgroundHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8A93A6" Offset="0.0" />
        <GradientStop Color="#8A93A6" Offset="0.10" />
        <GradientStop Color="#71809A" Offset="0.11" />
        <GradientStop Color="#71809A" Offset="0.72" />
        <GradientStop Color="#74919F" Offset="0.73" />
        <GradientStop Color="#74919F" Offset="0.80" />
        <GradientStop Color="#8A93A6" Offset="0.81" />
        <GradientStop Color="#8A93A6" Offset="0.93" />
        <GradientStop Color="#97A9BF" Offset="0.94" />
        <GradientStop Color="#97A9BF" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShowDesktopGloss" Color="Transparent" />
</ResourceDictionary>
