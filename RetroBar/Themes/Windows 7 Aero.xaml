<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Windows 7 Aero. Until measured Windows 7 taskbar images are supplied, this theme is the Windows Vista Aero
        taskbar exactly: the same bar, glass, Start orb, task buttons, Quick Launch, tray and clock, with nothing
        redefined here. The Windows 7 look is to be built in this file, on top of Vista's, from those images.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Windows Vista Aero.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
