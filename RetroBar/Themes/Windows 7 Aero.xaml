<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!--
        Windows 7 Aero. Until measured Windows 7 taskbar images are supplied, the taskbar is Vista's exactly
        (background, Start orb, tray, clock, glass) and this theme adds only the superbar: Windows 7's icon-only
        buttons, pinned programs first, drawn with the Vista task button brushes at Vista's height.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Windows Vista Aero.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <system:Boolean x:Key="UseSuperbar">True</system:Boolean>

    <!-- Progress shown by a program, drawn across its button as Windows 7 does -->
    <LinearGradientBrush x:Key="SuperbarProgressNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B07AE85A" Offset="0.0" />
        <GradientStop Color="#9940C030" Offset="0.5" />
        <GradientStop Color="#9930A020" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuperbarProgressPaused" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0F0E070" Offset="0.0" />
        <GradientStop Color="#99D8C020" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuperbarProgressError" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0F07A6A" Offset="0.0" />
        <GradientStop Color="#99D03020" Offset="1.0" />
    </LinearGradientBrush>

    <Style TargetType="Image"
           x:Key="SuperbarIcon">
        <Setter Property="Width"
                Value="16" />
        <Setter Property="Height"
                Value="16" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="RenderOptions.BitmapScalingMode"
                Value="HighQuality" />
    </Style>

    <Style TargetType="Image"
           x:Key="SuperbarOverlayIcon">
        <Setter Property="Width"
                Value="10" />
        <Setter Property="Height"
                Value="10" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="12,12,0,0" />
    </Style>

    <!--
        Superbar buttons: a 40 px button and Vista's 2 px gap, in Vista's 30 px row. The frame is Vista's task button
        frame; a pinned program that is not running has none until it is hovered. Each extra window draws a stacked
        edge 4 px to the right, which narrows the button by the same amount.
    -->
    <Style TargetType="Button"
           x:Key="SuperbarButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Width"
                Value="42" />
        <Setter Property="Height"
                Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent"
                          Margin="0,1,2,1"
                          x:Name="Slot">
                        <Border x:Name="Stack2"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource TaskButtonOuterBorder}">
                            <Border CornerRadius="2"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource TaskButtonInnerBorder}"
                                    Background="{DynamicResource TaskButtonBackground}" />
                        </Border>
                        <Border x:Name="Stack1"
                                Margin="4,0,0,0"
                                Visibility="Collapsed"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource TaskButtonOuterBorder}">
                            <Border CornerRadius="2"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource TaskButtonInnerBorder}"
                                    Background="{DynamicResource TaskButtonBackground}" />
                        </Border>
                        <Grid x:Name="Main">
                            <Border x:Name="Outer"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    Background="Transparent">
                                <Border x:Name="Inner"
                                        CornerRadius="2"
                                        BorderThickness="1"
                                        BorderBrush="Transparent"
                                        Background="Transparent"
                                        ClipToBounds="True">
                                    <Border x:Name="InnerTopRight"
                                            CornerRadius="2"
                                            BorderThickness="0,1,1,0"
                                            BorderBrush="Transparent">
                                        <Border x:Name="InnerBottomLeft"
                                                CornerRadius="2"
                                                BorderThickness="1,0,0,1"
                                                BorderBrush="Transparent">
                                            <Rectangle x:Name="Progress"
                                                       Visibility="Collapsed"
                                                       Fill="{DynamicResource SuperbarProgressNormal}"
                                                       RenderTransformOrigin="0,0.5">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Path=ProgressFraction, Mode=OneWay}" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=IsRunning}"
                                     Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonOuterBorder}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBorder}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackground}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerTopRightBorder}" />
                            <Setter TargetName="InnerBottomLeft"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBottomLeftBorder}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=HasStack}"
                                     Value="True">
                            <Setter TargetName="Stack1"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="Main"
                                    Property="Margin"
                                    Value="0,0,4,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=HasDoubleStack}"
                                     Value="True">
                            <Setter TargetName="Stack2"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="Stack1"
                                    Property="Margin"
                                    Value="4,0,4,0" />
                            <Setter TargetName="Main"
                                    Property="Margin"
                                    Value="0,0,8,0" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonOuterBorderHover}" />
                            <Setter TargetName="Outer"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBottomBackgroundHover}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBorderHover}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundHover}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerTopRightBorderHover}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="BorderThickness"
                                    Value="1,1,1,0" />
                            <Setter TargetName="InnerBottomLeft"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBottomLeftBorderHover}" />
                            <Setter TargetName="InnerBottomLeft"
                                    Property="BorderThickness"
                                    Value="0,0,0,1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=IsActive}"
                                     Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonOuterBorderActive}" />
                            <Setter TargetName="Outer"
                                    Property="Background"
                                    Value="Transparent" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBorderActive}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundActive}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerTopRightBorderActive}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="BorderThickness"
                                    Value="0,1,1,0" />
                            <Setter TargetName="InnerBottomLeft"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBottomLeftBorderActive}" />
                            <Setter TargetName="InnerBottomLeft"
                                    Property="BorderThickness"
                                    Value="1,0,0,1" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive}"
                                           Value="True" />
                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                                           Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundActiveHover}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBottomBackgroundActiveHover}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Path=IsFlashing}"
                                     Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonOuterBorderFlashing}" />
                            <Setter TargetName="Outer"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBottomBackgroundFlashing}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBorderFlashing}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundFlashing}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerTopRightBorderFlashing}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="BorderThickness"
                                    Value="1,1,1,0" />
                            <Setter TargetName="InnerTopRight"
                                    Property="Background"
                                    Value="Transparent" />
                            <Setter TargetName="InnerBottomLeft"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBottomLeftBorderFlashing}" />
                            <Setter TargetName="InnerBottomLeft"
                                    Property="BorderThickness"
                                    Value="0,0,0,1" />
                        </DataTrigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonOuterBorderActive}" />
                            <Setter TargetName="Outer"
                                    Property="Background"
                                    Value="Transparent" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBorderActive}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource TaskButtonBackgroundActive}" />
                            <Setter TargetName="InnerTopRight"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerTopRightBorderActive}" />
                            <Setter TargetName="InnerBottomLeft"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TaskButtonInnerBottomLeftBorderActive}" />
                            <Setter TargetName="Content"
                                    Property="Margin"
                                    Value="1,1,0,0" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=ShowsProgress}"
                                     Value="True">
                            <Setter TargetName="Progress"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsProgressPaused}"
                                     Value="True">
                            <Setter TargetName="Progress"
                                    Property="Fill"
                                    Value="{DynamicResource SuperbarProgressPaused}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsProgressError}"
                                     Value="True">
                            <Setter TargetName="Progress"
                                    Property="Fill"
                                    Value="{DynamicResource SuperbarProgressError}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <Setter TargetName="Slot"
                                    Property="Margin"
                                    Value="1,0,1,2" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- On a vertical taskbar each button fills the bar's width, as Vista's task buttons do -->
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <Setter Property="Width"
                        Value="{Binding Path=ViewportWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ScrollViewer}}}" />
                <Setter Property="Height"
                        Value="30" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Windows 7 Basic draws the same buttons over Vista Basic's opaque taskbar -->
    <Style TargetType="Button"
           x:Key="SuperbarButtonBasic"
           BasedOn="{StaticResource SuperbarButton}" />
</ResourceDictionary>
