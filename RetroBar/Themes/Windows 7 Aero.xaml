<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!--
        Windows 7 (Aero, the default "Sky" colour). Built on Windows Vista Aero, which supplies the tooltips, balloons,
        menus and tray details Windows 7 kept; everything Windows 7 changed is redefined here.
        Geometry is measured from Windows 7 at 100% scale: a 40 px bar, 62 px button slots (a 60 px button and a 2 px gap),
        the Windows Vista Start orb (until the Windows 7 orb image is supplied), a two-line clock and a 15 px Show Desktop strip at the far end.
        While "Enable Aero glass" is off, every part switches to the opaque Windows 7 Basic look (the *Basic keys).
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Windows Vista Aero.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <system:Double x:Key="TaskbarHeight">40</system:Double>
    <system:Double x:Key="TaskbarRowHeight">40</system:Double>
    <system:Double x:Key="TaskbarWidth">70</system:Double>
    <system:Boolean x:Key="AllowsTransparency">True</system:Boolean>
    <system:Boolean x:Key="AlternatesAppearanceWhenMaximized">False</system:Boolean>
    <system:Boolean x:Key="UseLargeIcons">True</system:Boolean>
    <system:Boolean x:Key="UseSuperbar">True</system:Boolean>

    <!-- Taskbar: glass tinted with the Sky colour; a dark line and a light line along the top edge -->
    <LinearGradientBrush x:Key="TaskbarBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#802A5683" Offset="0.0" />
        <GradientStop Color="#801C4A7A" Offset="0.5" />
        <GradientStop Color="#8C143D66" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskbarVerticalBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#802A5683" Offset="0.0" />
        <GradientStop Color="#801C4A7A" Offset="0.5" />
        <GradientStop Color="#8C143D66" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TaskbarTopBorder" Color="#8C000000" />
    <SolidColorBrush x:Key="TaskbarTopInnerBorder" Color="#7FE0E6EE" />

    <!-- Windows 7 Basic taskbar, measured: dark line, light line, flat light blue -->
    <SolidColorBrush x:Key="TaskbarBackgroundBasic" Color="#A7C0DC" />
    <SolidColorBrush x:Key="TaskbarTopBorderBasic" Color="#434D58" />
    <SolidColorBrush x:Key="TaskbarTopInnerBorderBasic" Color="#CAD9EA" />

    <SolidColorBrush x:Key="ClockForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ClockForegroundBasic" Color="#000000" />
    <SolidColorBrush x:Key="InputLanguageForegroundBasic" Color="#000000" />
    <SolidColorBrush x:Key="TrayToggleArrowForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TrayToggleArrowForegroundBasic" Color="#1E2833" />

    <ToolTip x:Key="StartButtonTip" Content="{DynamicResource start_button_tip_vista}" />

    <Style TargetType="ContentControl"
           x:Key="Taskbar"
           BasedOn="{StaticResource Taskbar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- Glass tint layer, faded by the Aero glass transparency setting; the content is drawn over it -->
                        <Border BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource TaskbarTopBorder}"
                                Opacity="{Binding Path=GlassTintOpacity, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                x:Name="TaskbarTopBorder">
                            <Border BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource TaskbarTopInnerBorder}"
                                    Background="{DynamicResource TaskbarBackground}"
                                    x:Name="TaskbarTopInnerBorder" />
                        </Border>
                        <!-- Buttons cover the two top lines, as in Windows 7 -->
                        <ContentPresenter Name="Content" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="TaskbarTopBorder"
                                        Property="BorderThickness"
                                        Value="1,0,0,0" />
                                <Setter TargetName="TaskbarTopInnerBorder"
                                        Property="BorderThickness"
                                        Value="1,0,0,0" />
                                <Setter TargetName="TaskbarTopInnerBorder"
                                        Property="Background"
                                        Value="{DynamicResource TaskbarVerticalBackground}" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                        <!-- Aero glass turned off: the opaque Windows 7 Basic look -->
                        <DataTrigger Binding="{Binding Path=IsAeroGlassEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="False">
                            <DataTrigger.Setters>
                                <Setter TargetName="TaskbarTopBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TaskbarTopBorderBasic}" />
                                <Setter TargetName="TaskbarTopInnerBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TaskbarTopInnerBorderBasic}" />
                                <Setter TargetName="TaskbarTopInnerBorder"
                                        Property="Background"
                                        Value="{DynamicResource TaskbarBackgroundBasic}" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Start orb: the Windows Vista orb (its images, size and floating window, from Windows Vista Aero) until the
        Windows 7 orb image is supplied.
    -->
    <!--
        Superbar buttons. A slot is 62 px: a 60 px button and a 2 px gap. A program with more than one window shows
        the buttons stacked behind it inside the same 60 px, as Windows 7 does: with two windows the button is 55 px
        and one copy of it shows 5 px to its right; with three or more it is 52 px and two copies show 4 px each.
        Each copy is the same button in the same state (normal, hover, active, flashing), of which only the exposed
        right edge is drawn. Measured from Windows 7 at 100% scale.
        A pinned program that is not running has no frame until it is hovered.
    -->
    <SolidColorBrush x:Key="SuperbarButtonOuterBorder" Color="#73000000" />
    <LinearGradientBrush x:Key="SuperbarButtonInnerBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FFFFFF" Offset="0.0" />
        <GradientStop Color="#33FFFFFF" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuperbarButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0.0" />
        <GradientStop Color="#1EFFFFFF" Offset="0.45" />
        <GradientStop Color="#0DFFFFFF" Offset="0.46" />
        <GradientStop Color="#1AFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuperbarButtonOuterBorderHover" Color="#80000000" />
    <LinearGradientBrush x:Key="SuperbarButtonInnerBorderHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3FFFFFF" Offset="0.0" />
        <GradientStop Color="#4DFFFFFF" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuperbarButtonBackgroundHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0.0" />
        <GradientStop Color="#33FFFFFF" Offset="0.45" />
        <GradientStop Color="#1AFFFFFF" Offset="0.46" />
        <GradientStop Color="#26FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuperbarButtonOuterBorderActive" Color="#8C000000" />
    <LinearGradientBrush x:Key="SuperbarButtonInnerBorderActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF" Offset="0.0" />
        <GradientStop Color="#66FFFFFF" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuperbarButtonBackgroundActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FFFFFF" Offset="0.0" />
        <GradientStop Color="#4DFFFFFF" Offset="0.45" />
        <GradientStop Color="#33FFFFFF" Offset="0.46" />
        <GradientStop Color="#40FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuperbarButtonOuterBorderPressed" Color="#99000000" />
    <SolidColorBrush x:Key="SuperbarButtonInnerBorderPressed" Color="#4DFFFFFF" />
    <LinearGradientBrush x:Key="SuperbarButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FFFFFF" Offset="0.0" />
        <GradientStop Color="#0DFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuperbarButtonOuterBorderFlashing" Color="#B3613600" />
    <LinearGradientBrush x:Key="SuperbarButtonInnerBorderFlashing" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFE7B0" Offset="0.0" />
        <GradientStop Color="#80FFC66B" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuperbarButtonBackgroundFlashing" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFC870" Offset="0.0" />
        <GradientStop Color="#D9F5A43A" Offset="0.45" />
        <GradientStop Color="#D9EA8F1C" Offset="0.46" />
        <GradientStop Color="#E6F4A93F" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuperbarProgressNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B07AE85A" Offset="0.0" />
        <GradientStop Color="#9940C030" Offset="0.5" />
        <GradientStop Color="#9930A020" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuperbarProgressPaused" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0F0E070" Offset="0.0" />
        <GradientStop Color="#99D8C020" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuperbarProgressError" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0F07A6A" Offset="0.0" />
        <GradientStop Color="#99D03020" Offset="1.0" />
    </LinearGradientBrush>

    <Style TargetType="Image"
           x:Key="SuperbarIcon">
        <Setter Property="Width"
                Value="32" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="RenderOptions.BitmapScalingMode"
                Value="HighQuality" />
    </Style>

    <Style TargetType="Image"
           x:Key="SuperbarOverlayIcon">
        <Setter Property="Width"
                Value="16" />
        <Setter Property="Height"
                Value="16" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="24,24,0,0" />
    </Style>

    <Style TargetType="Button"
           x:Key="SuperbarButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Width"
                Value="62" />
        <Setter Property="Height"
                Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent"
                          Margin="0,0,2,0"
                          x:Name="Slot">
                        <!--
                            Stacked windows: copies of the button, as wide as Main and in its current brushes, set
                            behind it to the right. Each is clipped to the strip it exposes, so the glass of the copies
                            never adds up under the button. Stack2 is the rearmost.
                        -->
                        <Grid x:Name="Stack2"
                              Visibility="Collapsed"
                              HorizontalAlignment="Right"
                              Width="4"
                              ClipToBounds="True">
                            <Border HorizontalAlignment="Right"
                                    Width="{Binding ActualWidth, ElementName=Main}"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{Binding BorderBrush, ElementName=Outer}">
                                <Border CornerRadius="2"
                                        BorderThickness="1"
                                        BorderBrush="{Binding BorderBrush, ElementName=Inner}"
                                        Background="{Binding Background, ElementName=Inner}" />
                            </Border>
                        </Grid>
                        <Grid x:Name="Stack1"
                              Visibility="Collapsed"
                              HorizontalAlignment="Right"
                              Width="5"
                              ClipToBounds="True">
                            <Border HorizontalAlignment="Right"
                                    Width="{Binding ActualWidth, ElementName=Main}"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{Binding BorderBrush, ElementName=Outer}">
                                <Border CornerRadius="2"
                                        BorderThickness="1"
                                        BorderBrush="{Binding BorderBrush, ElementName=Inner}"
                                        Background="{Binding Background, ElementName=Inner}" />
                            </Border>
                        </Grid>
                        <Grid x:Name="Main">
                            <Border x:Name="Outer"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="Transparent">
                                <Border x:Name="Inner"
                                        CornerRadius="2"
                                        BorderThickness="1"
                                        BorderBrush="Transparent"
                                        Background="Transparent"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- Progress shown by the program, drawn across the button -->
                                        <Rectangle x:Name="Progress"
                                                   Visibility="Collapsed"
                                                   Fill="{DynamicResource SuperbarProgressNormal}"
                                                   RenderTransformOrigin="0,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Path=ProgressFraction, Mode=OneWay}" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <!-- Hover glow in the icon's colour, following the mouse -->
                                        <Border x:Name="Glow"
                                                Opacity="0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Path=HotTrackColor, Mode=OneWay}" />
                                            </Border.Background>
                                            <Border.OpacityMask>
                                                <RadialGradientBrush Center="{Binding Path=HotTrackCenter, Mode=OneWay}"
                                                                     GradientOrigin="{Binding Path=HotTrackCenter, Mode=OneWay}"
                                                                     RadiusX="0.75"
                                                                     RadiusY="0.95">
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                </RadialGradientBrush>
                                            </Border.OpacityMask>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=IsRunning}"
                                     Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonOuterBorder}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonInnerBorder}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource SuperbarButtonBackground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=HasStack}"
                                     Value="True">
                            <Setter TargetName="Stack1"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="Main"
                                    Property="Margin"
                                    Value="0,0,5,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=HasDoubleStack}"
                                     Value="True">
                            <Setter TargetName="Stack2"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="Stack1"
                                    Property="Width"
                                    Value="4" />
                            <Setter TargetName="Stack1"
                                    Property="Margin"
                                    Value="0,0,4,0" />
                            <Setter TargetName="Main"
                                    Property="Margin"
                                    Value="0,0,8,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsActive}"
                                     Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonOuterBorderActive}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonInnerBorderActive}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource SuperbarButtonBackgroundActive}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsFlashing}"
                                     Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonOuterBorderFlashing}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonInnerBorderFlashing}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource SuperbarButtonBackgroundFlashing}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=ShowsProgress}"
                                     Value="True">
                            <Setter TargetName="Progress"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsProgressPaused}"
                                     Value="True">
                            <Setter TargetName="Progress"
                                    Property="Fill"
                                    Value="{DynamicResource SuperbarProgressPaused}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsProgressError}"
                                     Value="True">
                            <Setter TargetName="Progress"
                                    Property="Fill"
                                    Value="{DynamicResource SuperbarProgressError}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonOuterBorderHover}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonInnerBorderHover}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource SuperbarButtonBackgroundHover}" />
                            <Setter TargetName="Glow"
                                    Property="Opacity"
                                    Value="{DynamicResource SuperbarGlowOpacity}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonOuterBorderPressed}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SuperbarButtonInnerBorderPressed}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource SuperbarButtonBackgroundPressed}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <Setter TargetName="Slot"
                                    Property="Margin"
                                    Value="0,0,0,2" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <Setter Property="Width"
                        Value="60" />
                <Setter Property="Height"
                        Value="42" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <system:Double x:Key="SuperbarGlowOpacity">0.8</system:Double>

    <!--
        Windows 7 Basic buttons, measured: a dark outline darkest at the top, a light inner line, and a light blue fill
        brightest at the top left. Same template; only the brushes differ.
    -->
    <Style TargetType="Button"
           x:Key="SuperbarButtonBasic"
           BasedOn="{StaticResource SuperbarButton}">
        <Style.Resources>
            <LinearGradientBrush x:Key="SuperbarButtonOuterBorder" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0D0F12" Offset="0.0" />
                <GradientStop Color="#FF21262C" Offset="0.08" />
                <GradientStop Color="#FF2B3239" Offset="0.28" />
                <GradientStop Color="#FF4F5A68" Offset="0.53" />
                <GradientStop Color="#FF647384" Offset="0.79" />
                <GradientStop Color="#FF5A6877" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SuperbarButtonInnerBorder" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF6F8FB" Offset="0.0" />
                <GradientStop Color="#FFECF1F7" Offset="0.1" />
                <GradientStop Color="#FFDEE7F2" Offset="0.5" />
                <GradientStop Color="#FFCCDBEB" Offset="0.85" />
                <GradientStop Color="#FFC6D6E8" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SuperbarButtonBackground" StartPoint="0,0" EndPoint="0.37,1">
                <GradientStop Color="#FFE7EEF5" Offset="0.0" />
                <GradientStop Color="#FFD0DDEC" Offset="0.226" />
                <GradientStop Color="#FFBBCEE4" Offset="0.44" />
                <GradientStop Color="#FFAFC6DF" Offset="0.654" />
                <GradientStop Color="#FFAEC5DF" Offset="0.75" />
                <GradientStop Color="#FFAEC5DF" Offset="1.0" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="SuperbarButtonOuterBorderHover" Color="#FF3C4A5C" />
            <LinearGradientBrush x:Key="SuperbarButtonInnerBorderHover" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                <GradientStop Color="#FFE3ECF7" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SuperbarButtonBackgroundHover" StartPoint="0,0" EndPoint="0.37,1">
                <GradientStop Color="#FFF4F8FC" Offset="0.0" />
                <GradientStop Color="#FFD4E2F2" Offset="0.44" />
                <GradientStop Color="#FFC4D7EE" Offset="1.0" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="SuperbarButtonOuterBorderActive" Color="#FF1F252D" />
            <LinearGradientBrush x:Key="SuperbarButtonInnerBorderActive" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFB4C6DC" Offset="0.0" />
                <GradientStop Color="#FFE8EFF7" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SuperbarButtonBackgroundActive" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFC4D5EA" Offset="0.0" />
                <GradientStop Color="#FFCFDDEE" Offset="0.5" />
                <GradientStop Color="#FFDEE8F4" Offset="1.0" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="SuperbarButtonOuterBorderPressed" Color="#FF1F252D" />
            <SolidColorBrush x:Key="SuperbarButtonInnerBorderPressed" Color="#FFA9BCD3" />
            <LinearGradientBrush x:Key="SuperbarButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFB8CCE4" Offset="0.0" />
                <GradientStop Color="#FFCCDBEC" Offset="1.0" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="SuperbarButtonOuterBorderFlashing" Color="#FF8A5C1E" />
            <SolidColorBrush x:Key="SuperbarButtonInnerBorderFlashing" Color="#FFFFF4D8" />
            <LinearGradientBrush x:Key="SuperbarButtonBackgroundFlashing" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFCE7B5" Offset="0.0" />
                <GradientStop Color="#FFF7C76A" Offset="0.5" />
                <GradientStop Color="#FFF4B649" Offset="1.0" />
            </LinearGradientBrush>

            <system:Double x:Key="SuperbarGlowOpacity">0.35</system:Double>
        </Style.Resources>
    </Style>

    <!-- Two-line clock: time over the short date, centred, as Windows 7 shows it in a 40 px bar -->
    <Style TargetType="TextBlock"
           x:Key="Clock"
           BasedOn="{StaticResource Clock}">
        <Setter Property="Margin"
                Value="15,0,6,0" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="0,1" />
                </DataTrigger.Setters>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=IsAeroGlassEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource ClockForegroundBasic}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate TargetType="{x:Type UserControl}"
                     x:Key="ClockTemplateKey">
        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding Path=Now, StringFormat=t, Mode=OneWay}"
                       Style="{DynamicResource Clock}"
                       Name="ClockText" />
            <TextBlock Text="{Binding Path=Now, StringFormat=dddd, Mode=OneWay}"
                       Style="{DynamicResource Clock}"
                       Name="ClockVerticalDayOfWeek"
                       Visibility="Collapsed" />
            <TextBlock Text="{Binding Path=Now, StringFormat=d, Mode=OneWay}"
                       Style="{DynamicResource Clock}"
                       Name="ClockDate" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <Setter TargetName="ClockVerticalDayOfWeek"
                        Property="Visibility"
                        Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBlock"
           x:Key="InputLanguage"
           BasedOn="{StaticResource InputLanguage}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsAeroGlassEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource InputLanguageForegroundBasic}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Notification area icons sit 24 px apart -->
    <Style TargetType="Image"
           x:Key="NotifyIcon"
           BasedOn="{StaticResource NotifyIcon}">
        <Setter Property="Margin"
                Value="4,1,4,1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="1,4" />
                </DataTrigger.Setters>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- "Show hidden icons": a small upward arrow -->
    <Geometry x:Key="Windows7TrayArrow">M 0,4 L 3.5,0 L 7,4 Z</Geometry>

    <Style TargetType="ToggleButton"
           x:Key="TrayToggleButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Width"
                Value="16" />
        <Setter Property="Height"
                Value="24" />
        <Setter Property="Margin"
                Value="0,0,5,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ButtonBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Path x:Name="ToggleArrow"
                              Fill="{DynamicResource TrayToggleArrowForeground}"
                              Data="{DynamicResource Windows7TrayArrow}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#33FFFFFF" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#66FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1A000000" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="ToggleArrow"
                                    Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleY="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=IsAeroGlassEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="False">
                            <Setter TargetName="ToggleArrow"
                                    Property="Fill"
                                    Value="{DynamicResource TrayToggleArrowForegroundBasic}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="{DynamicResource hide}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="ToolTip" Value="{DynamicResource show_hidden}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin"
                            Value="0,0,0,1" />
                    <Setter Property="Width"
                            Value="24" />
                    <Setter Property="Height"
                            Value="16" />
                </DataTrigger.Setters>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The superbar fills the space up to the notification area -->
    <Style x:Key="TaskListScrollViewer"
           TargetType="ScrollViewer"
           BasedOn="{StaticResource TaskListScrollViewer}">
        <Setter Property="Margin"
                Value="0,0,6,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <Setter Property="Margin"
                        Value="0,0,0,6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Show Desktop: a 15 px glass strip at the far end of the bar, measured: dark outer and light inner lines on its
        sides and bottom, and a gloss along the top. Hovering it peeks at the desktop when that is turned on.
    -->
    <SolidColorBrush x:Key="ShowDesktopOuterBorder" Color="#99000000" />
    <SolidColorBrush x:Key="ShowDesktopInnerBorder" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="ShowDesktopBackground" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ShowDesktopBackgroundHover" Color="#4DFFFFFF" />
    <LinearGradientBrush x:Key="ShowDesktopGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShowDesktopOuterBorderBasic" Color="#FF6A7B8F" />
    <SolidColorBrush x:Key="ShowDesktopInnerBorderBasic" Color="#FFE6EEF7" />
    <LinearGradientBrush x:Key="ShowDesktopBackgroundBasic" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD3E0EF" Offset="0.0" />
        <GradientStop Color="#FFB2C9E2" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShowDesktopBackgroundHoverBasic" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF2F7FC" Offset="0.0" />
        <GradientStop Color="#FFCFDFF1" Offset="1.0" />
    </LinearGradientBrush>

    <Style TargetType="ToggleButton"
           x:Key="ShowDesktopButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Width"
                Value="15" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
        <Setter Property="Margin"
                Value="0,2,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Outer"
                            BorderThickness="1,0,1,1"
                            BorderBrush="{DynamicResource ShowDesktopOuterBorder}">
                        <Border x:Name="Inner"
                                BorderThickness="1,0,1,1"
                                BorderBrush="{DynamicResource ShowDesktopInnerBorder}"
                                Background="{DynamicResource ShowDesktopBackground}">
                            <Grid>
                                <Border x:Name="Gloss"
                                        Height="8"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ShowDesktopGloss}" />
                                <ContentPresenter Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource ShowDesktopBackgroundHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <Setter TargetName="Outer"
                                    Property="BorderThickness"
                                    Value="0,1,1,1" />
                            <Setter TargetName="Inner"
                                    Property="BorderThickness"
                                    Value="0,1,1,1" />
                            <Setter TargetName="Gloss"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsAeroGlassEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="False">
                            <Setter TargetName="Outer"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ShowDesktopOuterBorderBasic}" />
                            <Setter TargetName="Inner"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ShowDesktopInnerBorderBasic}" />
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource ShowDesktopBackgroundBasic}" />
                            <Setter TargetName="Gloss"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsAeroGlassEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                           Value="False" />
                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}"
                                           Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Inner"
                                    Property="Background"
                                    Value="{DynamicResource ShowDesktopBackgroundHoverBasic}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="Height"
                        Value="15" />
                <Setter Property="Margin"
                        Value="2,0,0,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
