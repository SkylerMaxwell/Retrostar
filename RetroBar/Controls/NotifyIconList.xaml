<UserControl x:Class="RetroBar.Controls.NotifyIconList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RetroBar.Controls"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             xmlns:dd="urn:gong-wpf-dragdrop"
             Loaded="NotifyIconList_Loaded"
             Unloaded="NotifyIconList_OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:EdgeOrientationConverter x:Key="edgeOrientationConverter" />
            <converters:IconListOrientation x:Key="iconsOrientation" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel.Orientation>
            <Binding Converter="{StaticResource edgeOrientationConverter}"
                     Path="Orientation"
                     RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
        </StackPanel.Orientation>
        <ToggleButton Name="NotifyIconToggleButton"
                      Visibility="Collapsed"
                      Click="NotifyIconToggleButton_OnClick"
                      Unchecked="NotifyIconToggleButton_OnUnchecked"
                      Style="{DynamicResource TrayToggleButton}"/>
        <ItemsControl x:Name="NotifyIcons"
                      Focusable="False"
                      Style="{DynamicResource NotifyIconItems}"
                      dd:DragDrop.IsDragSource="True"
                      dd:DragDrop.IsDropTarget="True"
                      dd:DragDrop.DragDropContext="NotifyIconList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Background="Transparent">
                        <WrapPanel.Orientation>
                            <MultiBinding Converter="{StaticResource iconsOrientation}">
                                <Binding Path="Orientation"
                                         RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
                                <Binding Path="Rows"
                                         RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
                            </MultiBinding>
                        </WrapPanel.Orientation>
                    </WrapPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <ItemContainerTemplate>
                    <local:NotifyIcon Host="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"></local:NotifyIcon>
                </ItemContainerTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--
            Notification area overflow, for themes that set UseNotifyIconOverflow (Windows 7): the hidden icons in a flyout
            above the "show hidden icons" button, with a Customize link, in place of expanding them into the bar. The look
            is the theme's (NotifyIconOverflowFrame, NotifyIconOverflowItems, NotifyIconOverflowCell,
            NotifyIconOverflowCustomize); the frame's DataContext and the icon list's Tag are the taskbar.
        -->
        <Popup x:Name="OverflowPopup"
               PlacementTarget="{Binding ElementName=NotifyIconToggleButton}"
               Placement="Top"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="None"
               Opened="OverflowPopup_Opened"
               Closed="OverflowPopup_Closed">
            <ContentControl x:Name="OverflowFrame"
                            Focusable="False"
                            Style="{DynamicResource NotifyIconOverflowFrame}"
                            SizeChanged="OverflowFrame_SizeChanged">
                <StackPanel>
                    <ItemsControl x:Name="OverflowIcons"
                                  Focusable="False"
                                  Style="{DynamicResource NotifyIconOverflowItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Columns and rows as near square as the icons allow, wider than tall, as Windows 7 lays them out -->
                                <UniformGrid />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <ItemContainerTemplate>
                                <Border Style="{DynamicResource NotifyIconOverflowCell}">
                                    <local:NotifyIcon HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Host="{Binding Path=Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" />
                                </Border>
                            </ItemContainerTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="OverflowCustomizeButton"
                            Content="{DynamicResource customize}"
                            Style="{DynamicResource NotifyIconOverflowCustomize}"
                            Click="OverflowCustomizeButton_OnClick" />
                </StackPanel>
            </ContentControl>
        </Popup>
    </StackPanel>
</UserControl>
