<UserControl x:Class="RetroBar.Controls.SuperbarTaskList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RetroBar.Controls"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             Loaded="SuperbarTaskList_OnLoaded"
             Unloaded="SuperbarTaskList_OnUnloaded">
    <UserControl.Resources>
        <converters:EdgeOrientationConverter x:Key="orientationConverter" />
    </UserControl.Resources>
    <!-- Windows 7 taskbar buttons: one icon-only button per program, pinned programs first -->
    <ScrollViewer Style="{DynamicResource TaskListScrollViewer}"
                  x:Name="ButtonsScrollViewer"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ButtonsList"
                      Focusable="False"
                      HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel>
                        <WrapPanel.Orientation>
                            <Binding Converter="{StaticResource orientationConverter}"
                                     Path="Orientation"
                                     RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
                        </WrapPanel.Orientation>
                    </WrapPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:SuperbarButton Host="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:SuperbarTaskList}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
