<Window x:Class="RetroBar.StartMenu.VistaStartMenu"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        x:Name="Root"
        Title="Start menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        Deactivated="Window_Deactivated"
        Closed="Window_Closed"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>

        <!--
            Colours below are measured from Windows Vista screenshots at 100% scale.
            The frame is dark neutral glass, about 85% opaque, lightest at the top.
        -->
        <LinearGradientBrush x:Key="GlassFrameBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D9626262" Offset="0.0" />
            <GradientStop Color="#D9595959" Offset="0.11" />
            <GradientStop Color="#D93E3E3E" Offset="0.2" />
            <GradientStop Color="#D9303030" Offset="0.3" />
            <GradientStop Color="#D9202020" Offset="0.4" />
            <GradientStop Color="#D9191919" Offset="0.5" />
            <GradientStop Color="#DB0F0F0F" Offset="0.6" />
            <GradientStop Color="#DD070707" Offset="0.7" />
            <GradientStop Color="#E0000000" Offset="0.8" />
            <GradientStop Color="#E0000000" Offset="1.0" />
        </LinearGradientBrush>
        <!-- Vista Basic: the same shading, opaque -->
        <LinearGradientBrush x:Key="BasicFrameBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF575757" Offset="0.0" />
            <GradientStop Color="#FF4D4D4D" Offset="0.11" />
            <GradientStop Color="#FF353535" Offset="0.2" />
            <GradientStop Color="#FF292929" Offset="0.3" />
            <GradientStop Color="#FF1C1C1C" Offset="0.4" />
            <GradientStop Color="#FF151515" Offset="0.5" />
            <GradientStop Color="#FF0D0D0D" Offset="0.6" />
            <GradientStop Color="#FF070707" Offset="0.7" />
            <GradientStop Color="#FF020202" Offset="0.8" />
            <GradientStop Color="#FF020202" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Left column highlight, as used throughout Vista -->
        <LinearGradientBrush x:Key="LeftHoverBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF2F8FE" Offset="0.0" />
            <GradientStop Color="#FFDCEBFC" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LeftPressedBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFDCEBFC" Offset="0.0" />
            <GradientStop Color="#FFC1DBFC" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="LeftHoverBorder" Color="#FF7DA2CE" />

        <!-- Right column highlight on glass -->
        <LinearGradientBrush x:Key="RightHoverBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0.0" />
            <GradientStop Color="#18FFFFFF" Offset="0.5" />
            <GradientStop Color="#06FFFFFF" Offset="0.5" />
            <GradientStop Color="#20FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LeftSeparator" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E2E2E2" Offset="0.0" />
            <GradientStop Color="#FFE2E2E2" Offset="0.12" />
            <GradientStop Color="#FFE2E2E2" Offset="0.88" />
            <GradientStop Color="#00E2E2E2" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RightSeparator" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0.0" />
            <GradientStop Color="#40FFFFFF" Offset="0.2" />
            <GradientStop Color="#40FFFFFF" Offset="0.8" />
            <GradientStop Color="#00FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <!--
            Power strip segments. Each is a gloss upper half over a dark lower half that brightens toward the bottom.
            Neutral for lock and options; the power button is red whatever its action. PowerShutDownBackground is Vista's
            power button measured row by row (20 rows: a light top line, a gloss upper half, a hard break, a dark lower half
            and a light bottom line) with the hue turned to red, each row's brightness kept and the gloss half's saturation raised by 30% so it
            reads as red.
        -->
        <LinearGradientBrush x:Key="StripNeutralBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFC1C2C4" Offset="0.0" />
            <GradientStop Color="#FFAEAFB1" Offset="0.05" />
            <GradientStop Color="#FFA2A3A5" Offset="0.15" />
            <GradientStop Color="#FF8A8B8D" Offset="0.25" />
            <GradientStop Color="#FF707173" Offset="0.35" />
            <GradientStop Color="#FF606163" Offset="0.45" />
            <GradientStop Color="#FF5A5B5D" Offset="0.5" />
            <GradientStop Color="#FF292A2C" Offset="0.5" />
            <GradientStop Color="#FF323335" Offset="0.6" />
            <GradientStop Color="#FF3F4346" Offset="0.7" />
            <GradientStop Color="#FF4A4E51" Offset="0.8" />
            <GradientStop Color="#FF4E5255" Offset="0.95" />
            <GradientStop Color="#FF84888B" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PowerShutDownBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFB69292" Offset="0.000" />
            <GradientStop Color="#FF984F4F" Offset="0.075" />
            <GradientStop Color="#FF9B4040" Offset="0.125" />
            <GradientStop Color="#FF924848" Offset="0.175" />
            <GradientStop Color="#FF894747" Offset="0.225" />
            <GradientStop Color="#FF7B4242" Offset="0.275" />
            <GradientStop Color="#FF784A4A" Offset="0.325" />
            <GradientStop Color="#FF724F4F" Offset="0.375" />
            <GradientStop Color="#FF755555" Offset="0.425" />
            <GradientStop Color="#FF6E4F4F" Offset="0.475" />
            <GradientStop Color="#FF6E4F4F" Offset="0.500" />
            <GradientStop Color="#FF3D2626" Offset="0.500" />
            <GradientStop Color="#FF3B1F1F" Offset="0.575" />
            <GradientStop Color="#FF381818" Offset="0.625" />
            <GradientStop Color="#FF300A0A" Offset="0.675" />
            <GradientStop Color="#FF2E0202" Offset="0.725" />
            <GradientStop Color="#FF320202" Offset="0.775" />
            <GradientStop Color="#FF330101" Offset="0.825" />
            <GradientStop Color="#FF330101" Offset="0.875" />
            <GradientStop Color="#FF380303" Offset="0.925" />
            <GradientStop Color="#FF6B4F4F" Offset="1.000" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="GlassTextGlow" BlurRadius="4" ShadowDepth="0" Opacity="0.5" Color="Black" />

        <!-- A row in the left column: pinned, recent, search results and All Programs -->
        <Style x:Key="LeftItemButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <!-- The search result Enter opens (a Tag of True, set by ResultTemplate) -->
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <system:Boolean>True</system:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftPressedBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A link in the right column, on glass -->
        <Style x:Key="RightItemButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Height" Value="33" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="9,0,6,0">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Effect="{StaticResource GlassTextGlow}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RightHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RightHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One segment of the joined power, lock and options strip -->
        <Style x:Key="PowerStripSegment" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{StaticResource StripNeutralBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Glow" Background="#00FFFFFF" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#38000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Program row with a large or small icon, depending on the Start menu settings -->
        <DataTemplate x:Key="ProgramTemplate">
            <Button Style="{StaticResource LeftItemButton}"
                    Padding="2,1"
                    MinHeight="{Binding ProgramRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Click="ProgramButton_Click"
                    MouseRightButtonUp="ProgramButton_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Source="{Binding Icon}"
                           Width="{Binding ProgramIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding ProgramIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="0,0,4,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="NameText"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="{Binding Subtitle}"
                                   Foreground="#FF6D6D6D"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBold}" Value="True">
                    <Setter TargetName="NameText" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSubtitle}" Value="True">
                    <Setter TargetName="SubtitleText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Search result row with a small icon -->
        <DataTemplate x:Key="ResultTemplate">
            <Button Style="{StaticResource LeftItemButton}"
                    Tag="{Binding IsDefaultResult}"
                    Padding="4,1"
                    MinHeight="22"
                    Click="ProgramButton_Click"
                    MouseRightButtonUp="ProgramButton_MouseRightButtonUp">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}"
                           Width="16"
                           Height="16"
                           Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- All Programs tree -->
        <HierarchicalDataTemplate x:Key="AllProgramsTemplate"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Height="20">
                <Image Source="{Binding Icon}"
                       Width="16"
                       Height="16"
                       Margin="0,0,6,0" />
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="190" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="AllProgramsItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,0"
                                    MouseLeftButtonUp="AllProgramsItem_MouseLeftButtonUp"
                                    MouseRightButtonUp="AllProgramsItem_MouseRightButtonUp">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"
                                            Margin="14,0,0,0"
                                            Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultsHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF1E3287" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,6,6,2" />
        </Style>

        <!--
            Scrollbar of the Start menu's scrolling lists, as Windows Vista and Windows 7 draw it (Aero): a 17 px light
            track, small dark arrow glyphs with no button face until hovered, and a rounded grey thumb, lighter on its
            left half, with a ribbed grip. Hovered, the thumb and the arrow buttons turn light blue; pressed, a deeper
            blue. Only the Start menu's ScrollViewers (FlatScrollViewer) use it.
        -->
        <LinearGradientBrush x:Key="ScrollTrackBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFE5E3E0" Offset="0.0" />
            <GradientStop Color="#FFEEEDEB" Offset="0.12" />
            <GradientStop Color="#FFEEEDEB" Offset="0.88" />
            <GradientStop Color="#FFF4F3F1" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ScrollThumbBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF4F3F1" Offset="0.0" />
            <GradientStop Color="#FFE6E7E9" Offset="0.45" />
            <GradientStop Color="#FFD4D6DA" Offset="0.5" />
            <GradientStop Color="#FFC9CBD0" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ScrollHoverBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFEAF6FD" Offset="0.0" />
            <GradientStop Color="#FFD9F0FC" Offset="0.45" />
            <GradientStop Color="#FFBEE6FD" Offset="0.5" />
            <GradientStop Color="#FFA7D9F5" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ScrollPressedBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFE5F4FC" Offset="0.0" />
            <GradientStop Color="#FFC4E5F6" Offset="0.45" />
            <GradientStop Color="#FF98D1EF" Offset="0.5" />
            <GradientStop Color="#FF68B3DB" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ScrollThumbBorder" Color="#FF9B9DA2" />
        <SolidColorBrush x:Key="ScrollHoverBorder" Color="#FF3C7FB1" />
        <SolidColorBrush x:Key="ScrollPressedBorder" Color="#FF2C628B" />
        <SolidColorBrush x:Key="ScrollGlyph" Color="#FF20354E" />
        <SolidColorBrush x:Key="ScrollGripDark" Color="#FF46576D" />

        <!-- An arrow button: the glyph alone, framed only while hovered or pressed -->
        <Style x:Key="ScrollArrowButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd"
                                Margin="1,0"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Background="Transparent">
                            <Border x:Name="Inner"
                                    CornerRadius="1"
                                    BorderThickness="1"
                                    BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollHoverBorder}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="#A0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollPressedBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollPressedBorder}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="#60FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The track on either side of the thumb: clicking pages, nothing is drawn -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd"
                                Margin="1,0"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="{StaticResource ScrollThumbBorder}"
                                Background="{StaticResource ScrollThumbBackground}">
                            <Border x:Name="Inner"
                                    CornerRadius="1"
                                    BorderThickness="1"
                                    BorderBrush="#B0FFFFFF"
                                    ClipToBounds="True">
                                <!-- Ribbed grip: four dark lines, each over a light one; clipped on a very short thumb -->
                                <Canvas x:Name="Grip"
                                        Width="7"
                                        Height="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Rectangle Canvas.Top="0" Width="7" Height="1" Fill="{StaticResource ScrollGripDark}" />
                                    <Rectangle Canvas.Top="1" Width="7" Height="1" Fill="#E0FFFFFF" />
                                    <Rectangle Canvas.Top="2" Width="7" Height="1" Fill="{StaticResource ScrollGripDark}" />
                                    <Rectangle Canvas.Top="3" Width="7" Height="1" Fill="#E0FFFFFF" />
                                    <Rectangle Canvas.Top="4" Width="7" Height="1" Fill="{StaticResource ScrollGripDark}" />
                                    <Rectangle Canvas.Top="5" Width="7" Height="1" Fill="#E0FFFFFF" />
                                    <Rectangle Canvas.Top="6" Width="7" Height="1" Fill="{StaticResource ScrollGripDark}" />
                                    <Rectangle Canvas.Top="7" Width="7" Height="1" Fill="#E0FFFFFF" />
                                </Canvas>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollPressedBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollPressedBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Style.Resources>
                <!-- Applies to the vertical scrollbar inside these ScrollViewers only -->
                <Style TargetType="ScrollBar">
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="17" />
                            <Setter Property="MinWidth" Value="17" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="{StaticResource ScrollTrackBackground}"
                                              SnapsToDevicePixels="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="17" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="17" />
                                            </Grid.RowDefinitions>
                                            <RepeatButton Grid.Row="0"
                                                          Style="{StaticResource ScrollArrowButton}"
                                                          Command="ScrollBar.LineUpCommand">
                                                <Path Data="M 0,4 L 3.5,0 L 7,4 Z" Fill="{StaticResource ScrollGlyph}" />
                                            </RepeatButton>
                                            <Track x:Name="PART_Track"
                                                   Grid.Row="1"
                                                   IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                                  Command="ScrollBar.PageUpCommand" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                                  Command="ScrollBar.PageDownCommand" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                            <RepeatButton Grid.Row="2"
                                                          Style="{StaticResource ScrollArrowButton}"
                                                          Command="ScrollBar.LineDownCommand">
                                                <Path Data="M 0,0 L 7,0 L 3.5,4 Z" Fill="{StaticResource ScrollGlyph}" />
                                            </RepeatButton>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!--
            Windows 7 style. Measured from Windows 7 at 100% scale with the default Sky colour: a 411 x 476 frame,
            a 254 x 462 left pane 6 px in from each side that holds the search box in a light band at its bottom,
            and a joined "Shut down" and options button 94 x 22 level with the search box.
            The glass is darker in the middle of the frame and lighter towards the bottom, as Windows 7 draws it.
        -->
        <LinearGradientBrush x:Key="Win7GlassFrameBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CC3E7293" Offset="0.0" />
            <GradientStop Color="#CC1C5A7E" Offset="0.08" />
            <GradientStop Color="#CC0E2238" Offset="0.3" />
            <GradientStop Color="#CC16263A" Offset="0.5" />
            <GradientStop Color="#CC284A60" Offset="0.75" />
            <GradientStop Color="#CC33688A" Offset="0.9" />
            <GradientStop Color="#CC4E97C6" Offset="1.0" />
        </LinearGradientBrush>
        <!-- Windows 7 Basic: the light blue of Basic window frames, opaque -->
        <LinearGradientBrush x:Key="Win7BasicFrameBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFD6E3F1" Offset="0.0" />
            <GradientStop Color="#FFC2D5EA" Offset="0.5" />
            <GradientStop Color="#FFB4CAE3" Offset="1.0" />
        </LinearGradientBrush>

        <!-- The light band at the bottom of the left pane, measured: a grey top line, then pale blue -->
        <LinearGradientBrush x:Key="Win7SearchBandBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFD1D6DC" Offset="0.0" />
            <GradientStop Color="#FFD1D6DC" Offset="0.022" />
            <GradientStop Color="#FFDBE2EC" Offset="0.023" />
            <GradientStop Color="#FFEAF0FC" Offset="0.07" />
            <GradientStop Color="#FFF1F4FB" Offset="0.12" />
            <GradientStop Color="#FFF2F5FC" Offset="0.9" />
            <GradientStop Color="#FFF0FAFF" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Win7SearchBoxBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF3F4044" Offset="0.0" />
            <GradientStop Color="#FF6E7074" Offset="0.5" />
            <GradientStop Color="#FFA8ACAD" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Right column separator: a dark line over a light line, fading at both ends -->
        <LinearGradientBrush x:Key="Win7RightSeparator" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33000000" Offset="0.0" />
            <GradientStop Color="#33000000" Offset="0.5" />
            <GradientStop Color="#1FFFFFFF" Offset="0.5" />
            <GradientStop Color="#1FFFFFFF" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Win7RightSeparatorBasic" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40000000" Offset="0.0" />
            <GradientStop Color="#40000000" Offset="0.5" />
            <GradientStop Color="#CCFFFFFF" Offset="0.5" />
            <GradientStop Color="#CCFFFFFF" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Win7RightSeparatorMask" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00000000" Offset="0.0" />
            <GradientStop Color="#FF000000" Offset="0.12" />
            <GradientStop Color="#FF000000" Offset="0.85" />
            <GradientStop Color="#00000000" Offset="1.0" />
        </LinearGradientBrush>

        <!-- A link in the right column of the Windows 7 Basic menu: black text on the light frame -->
        <Style x:Key="RightItemButtonBasic7" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Height" Value="33" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="9,0,6,0">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One part of the joined "Shut down" button, measured: a gloss over the upper part of the glass,
            a light inner line, and a dark line around and between the parts.
        -->
        <SolidColorBrush x:Key="Win7ShutDownOuter" Color="#8F000000" />
        <Style x:Key="Win7ShutDownSegment" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                BorderThickness="1"
                                BorderBrush="#A6FFFFFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#78FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#45FFFFFF" Offset="0.3" />
                                    <GradientStop Color="#10FFFFFF" Offset="0.42" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.45" />
                                    <GradientStop Color="#24000000" Offset="0.65" />
                                    <GradientStop Color="#00000000" Offset="0.9" />
                                    <GradientStop Color="#14FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border x:Name="Glow" Background="#00FFFFFF" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.9" RadiusY="1.1">
                                            <GradientStop Color="#9966D8FF" Offset="0.0" />
                                            <GradientStop Color="#2066D8FF" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#3366D8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#40001020" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Foreground" Value="#FF000000" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFF6F9FC" Offset="0.0" />
                                            <GradientStop Color="#FFE2EBF5" Offset="0.45" />
                                            <GradientStop Color="#FFD3E0EF" Offset="0.46" />
                                            <GradientStop Color="#FFDCE7F3" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Geometry measured from Windows Vista at 100% scale: a 405 x 538 frame with a 1 px dark outline and
        a 1 px light inner edge, a 254 x 494 programs pane 7 px in from each side, a 24 px search box and
        power strip 6 px below it, and 6 px of glass around everything. The user picture sits inside the frame at
        the top of the right column, 6 px below the top edge, and the right column starts 73 px down, below it.
        Windows 7's values (ApplyLayout) differ: its picture overhangs the top edge.
        The user picture is drawn by its own window (UserPictureWindow), above the menu.
    -->
    <!-- The frame sizes the menu; its background and outline are painted by FrameTint so they can be faded alone -->
    <Border x:Name="Frame"
            Width="405"
            Height="538"
            CornerRadius="6"
            BorderThickness="1">
        <Grid>
            <!-- Glass tint layer over the whole frame, faded by the Aero glass transparency setting -->
            <Border x:Name="FrameTint"
                    Margin="-1"
                    CornerRadius="6"
                    BorderThickness="1"
                    Opacity="{Binding GlassTintOpacity, ElementName=Root}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource GlassFrameBackground}" />
                    <Setter Property="BorderBrush" Value="#E6000000" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter Property="Background" Value="{StaticResource BasicFrameBackground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWindows7, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Win7GlassFrameBackground}" />
                            <Setter Property="BorderBrush" Value="#99000000" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsWindows7, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                <Condition Binding="{Binding IsGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource Win7BasicFrameBackground}" />
                            <Setter Property="BorderBrush" Value="#FF6A7D92" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            </Border>
            <Border x:Name="FrameHighlight"
                    CornerRadius="5"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1" />

            <Grid x:Name="LayoutGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left column: a white pane with a light outer and dark inner edge -->
                <Border x:Name="LeftPane"
                        Grid.Column="0"
                        Grid.Row="0"
                        Margin="6,6,0,0"
                        Width="254"
                        Height="494"
                        CornerRadius="3"
                        BorderBrush="#FFA0A29E"
                        BorderThickness="1">
                    <Border x:Name="LeftPaneInner"
                            CornerRadius="2"
                            Background="#FFFFFFFF"
                            BorderBrush="#FF3A3B38"
                            BorderThickness="1">
                        <Grid Margin="1">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="LeftListRow" Height="459" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Pinned and recent programs -->
                            <StackPanel x:Name="HomeView"
                                        Grid.Row="0"
                                        KeyboardNavigation.DirectionalNavigation="Contained">
                                <ItemsControl x:Name="PinnedList"
                                              ItemsSource="{Binding PinnedPrograms, ElementName=Root}"
                                              ItemTemplate="{StaticResource ProgramTemplate}"
                                              Focusable="False" />
                                <Border x:Name="PinnedSeparator"
                                        Height="1"
                                        Margin="6,4"
                                        Background="{StaticResource LeftSeparator}" />
                                <ItemsControl x:Name="RecentList"
                                              ItemsSource="{Binding RecentPrograms, ElementName=Root}"
                                              ItemTemplate="{StaticResource ProgramTemplate}"
                                              Focusable="False" />
                            </StackPanel>

                            <ScrollViewer x:Name="AllProgramsView"
                                          Grid.Row="0"
                                          Style="{StaticResource FlatScrollViewer}"
                                          Visibility="Collapsed">
                                <TreeView x:Name="AllProgramsTree"
                                          ItemsSource="{Binding AllPrograms, ElementName=Root}"
                                          ItemTemplate="{StaticResource AllProgramsTemplate}"
                                          ItemContainerStyle="{StaticResource AllProgramsItem}"
                                          KeyDown="AllProgramsTree_KeyDown">
                                    <TreeView.Template>
                                        <ControlTemplate TargetType="TreeView">
                                            <ItemsPresenter />
                                        </ControlTemplate>
                                    </TreeView.Template>
                                </TreeView>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SearchView"
                                          Grid.Row="0"
                                          Style="{StaticResource FlatScrollViewer}"
                                          Visibility="Collapsed">
                                <StackPanel KeyboardNavigation.DirectionalNavigation="Contained">
                                    <TextBlock x:Name="ProgramsHeader"
                                               Style="{StaticResource ResultsHeader}"
                                               Text="{DynamicResource start_menu_programs_heading}" />
                                    <ItemsControl x:Name="SearchProgramsList"
                                                  ItemsSource="{Binding SearchPrograms, ElementName=Root}"
                                                  ItemTemplate="{StaticResource ResultTemplate}"
                                                  Focusable="False" />
                                    <TextBlock x:Name="FilesHeader"
                                               Style="{StaticResource ResultsHeader}"
                                               Text="{DynamicResource start_menu_files_heading}" />
                                    <ItemsControl x:Name="SearchFilesList"
                                                  ItemsSource="{Binding SearchFiles, ElementName=Root}"
                                                  ItemTemplate="{StaticResource ResultTemplate}"
                                                  Focusable="False" />
                                    <TextBlock x:Name="NoResultsText"
                                               Margin="8,10"
                                               Foreground="#FF6D6D6D"
                                               TextWrapping="Wrap"
                                               Text="{DynamicResource start_menu_no_results}" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="6,0"
                                    Background="{StaticResource LeftSeparator}" />

                            <Button x:Name="AllProgramsButton"
                                    Grid.Row="2"
                                    Style="{StaticResource LeftItemButton}"
                                    Margin="0,3,0,0"
                                    Padding="6,0"
                                    Height="24"
                                    Click="AllProgramsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="AllProgramsArrow"
                                          Data="M 0,0 L 4,4 L 0,8 Z"
                                          Fill="#FF000000"
                                          VerticalAlignment="Center"
                                          Margin="2,0,26,0" />
                                    <TextBlock x:Name="AllProgramsText"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Text="{DynamicResource start_menu_all_programs}" />
                                </StackPanel>
                            </Button>

                            <!-- Windows 7: the search box sits in a light band at the bottom of the pane -->
                            <Border x:Name="SearchBand"
                                    Grid.Row="3"
                                    Height="45"
                                    Margin="-1,0,-1,-1"
                                    CornerRadius="0,0,2,2"
                                    Background="{StaticResource Win7SearchBandBackground}"
                                    Visibility="Collapsed">
                                <Grid x:Name="SearchBandHost" />
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <!-- Right column; the first link starts below the user picture (73 px in Vista, 43 px in Windows 7) -->
                <StackPanel x:Name="RightColumn"
                            Grid.Column="1"
                            Grid.Row="0"
                            Margin="3,73,6,0"
                            KeyboardNavigation.DirectionalNavigation="Contained" />

                <!-- Search box: 2 px grey edge, white field -->
                <Border x:Name="SearchBoxBorder"
                        Grid.Column="0"
                        Grid.Row="1"
                        Margin="6,6,0,6"
                        Width="254"
                        Height="24"
                        CornerRadius="2"
                        BorderBrush="#FF6A6E68"
                        BorderThickness="1">
                    <Border x:Name="SearchBoxInner"
                            CornerRadius="1"
                            Background="#FFFFFFFF"
                            BorderBrush="#FF5D605B"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="1,0,22,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Margin="4,0,22,0"
                                       VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Foreground="#FF6D6D6D"
                                       IsHitTestVisible="False"
                                       Text="{DynamicResource start_menu_search_placeholder}" />
                            <Path HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0"
                                  Stroke="#FF3F5D8A"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  IsHitTestVisible="False"
                                  Data="M 7.5,7.5 L 11,11 M 4.5,0.5 A 4,4 0 1 1 4.49,0.5 Z" />
                        </Grid>
                    </Border>
                </Border>

                <!-- Power, lock and options: one joined 130 x 24 strip with a light outer and black inner edge -->
                <Border x:Name="PowerStrip"
                        Grid.Column="1"
                        Grid.Row="1"
                        Margin="5,6,0,6"
                        Width="130"
                        Height="24"
                        HorizontalAlignment="Left"
                        CornerRadius="3"
                        BorderBrush="#5EFFFFFF"
                        BorderThickness="1">
                    <Border CornerRadius="2"
                            BorderBrush="#FF000000"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="61" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="13" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PowerButton"
                                    Grid.Column="0"
                                    Style="{StaticResource PowerStripSegment}"
                                    Background="{StaticResource PowerShutDownBackground}"
                                    Click="PowerButton_Click">
                                <Path Stroke="#FFFFFFFF"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 6,0.9 A 5.1,5.1 0 1 1 5.99,0.9 Z M 6,2.4 L 6,5.6" />
                            </Button>
                            <Rectangle Grid.Column="1" Fill="#E0000000" />
                            <Button x:Name="LockButton"
                                    Grid.Column="2"
                                    Style="{StaticResource PowerStripSegment}"
                                    Click="LockButton_Click">
                                <Canvas Width="10" Height="13">
                                    <Path Stroke="#FFFFFFFF"
                                          StrokeThickness="1.6"
                                          Data="M 2.3,6 L 2.3,3.6 A 2.7,2.7 0 0 1 7.7,3.6 L 7.7,6" />
                                    <Rectangle Canvas.Left="0"
                                               Canvas.Top="5.5"
                                               Width="10"
                                               Height="7.5"
                                               RadiusX="1"
                                               RadiusY="1">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                <GradientStop Color="#FFE2E2E2" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Canvas>
                            </Button>
                            <Rectangle Grid.Column="3" Fill="#E0000000" />
                            <Button x:Name="PowerOptionsButton"
                                    Grid.Column="4"
                                    Style="{StaticResource PowerStripSegment}"
                                    Click="PowerOptionsButton_Click">
                                <Path Data="M 0,0 L 4,3.5 L 0,7 Z"
                                      Fill="#FFFFFFFF" />
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <!-- Windows 7: "Shut down" and its options, one joined 94 x 22 button level with the search box -->
                <Border x:Name="ShutDownGroup"
                        Grid.Column="1"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="6,0,0,19"
                        Height="22"
                        CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="{StaticResource Win7ShutDownOuter}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="21" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ShutDownButton"
                                Grid.Column="0"
                                Style="{StaticResource Win7ShutDownSegment}"
                                Click="PowerButton_Click">
                            <TextBlock x:Name="ShutDownText"
                                       Margin="0,0,0,1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Effect" Value="{StaticResource GlassTextGlow}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Effect" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Rectangle Grid.Column="1" Fill="{StaticResource Win7ShutDownOuter}" />
                        <Button x:Name="ShutDownOptionsButton"
                                Grid.Column="2"
                                Style="{StaticResource Win7ShutDownSegment}"
                                Click="PowerOptionsButton_Click">
                            <Path Data="M 0,0 L 4,3.5 L 0,7 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stroke="#59000000"
                                  StrokeThickness="0.5" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
