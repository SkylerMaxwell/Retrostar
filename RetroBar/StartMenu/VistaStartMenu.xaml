<Window x:Class="RetroBar.StartMenu.VistaStartMenu"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Start menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>

        <!-- Frame: Aero glass (translucent, blurred behind) and Basic (opaque) -->
        <LinearGradientBrush x:Key="GlassFrameBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B42B3036" Offset="0.0" />
            <GradientStop Color="#C41A1E22" Offset="0.45" />
            <GradientStop Color="#D00D0F11" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BasicFrameBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF4A5056" Offset="0.0" />
            <GradientStop Color="#FF2A2E32" Offset="0.45" />
            <GradientStop Color="#FF16181A" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2EFFFFFF" Offset="0.0" />
            <GradientStop Color="#0AFFFFFF" Offset="0.42" />
            <GradientStop Color="#00FFFFFF" Offset="0.43" />
            <GradientStop Color="#00FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Left column highlight, as used throughout Vista -->
        <LinearGradientBrush x:Key="LeftHoverBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF2F8FE" Offset="0.0" />
            <GradientStop Color="#FFDCEBFC" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LeftPressedBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFDCEBFC" Offset="0.0" />
            <GradientStop Color="#FFC1DBFC" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="LeftHoverBorder" Color="#FF7DA2CE" />

        <!-- Right column highlight on glass -->
        <LinearGradientBrush x:Key="RightHoverBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0.0" />
            <GradientStop Color="#18FFFFFF" Offset="0.5" />
            <GradientStop Color="#06FFFFFF" Offset="0.5" />
            <GradientStop Color="#20FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LeftSeparator" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00D5DCE4" Offset="0.0" />
            <GradientStop Color="#FFD5DCE4" Offset="0.15" />
            <GradientStop Color="#FFD5DCE4" Offset="0.85" />
            <GradientStop Color="#00D5DCE4" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RightSeparator" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0.0" />
            <GradientStop Color="#40FFFFFF" Offset="0.2" />
            <GradientStop Color="#40FFFFFF" Offset="0.8" />
            <GradientStop Color="#00FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Power button colours: amber for sleep and hibernate, red for shut down, as in Vista -->
        <LinearGradientBrush x:Key="PowerSleepBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF9C77A" Offset="0.0" />
            <GradientStop Color="#FFE8951E" Offset="0.5" />
            <GradientStop Color="#FFD97A00" Offset="0.5" />
            <GradientStop Color="#FFF0A436" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PowerShutDownBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF29A8E" Offset="0.0" />
            <GradientStop Color="#FFD84A36" Offset="0.5" />
            <GradientStop Color="#FFC32B16" Offset="0.5" />
            <GradientStop Color="#FFE0614B" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassButtonBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#70FFFFFF" Offset="0.0" />
            <GradientStop Color="#30FFFFFF" Offset="0.5" />
            <GradientStop Color="#18000000" Offset="0.5" />
            <GradientStop Color="#30FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="GlassTextGlow" BlurRadius="6" ShadowDepth="0" Opacity="0.75" Color="Black" />

        <!-- A row in the left column: pinned, recent, search results and All Programs -->
        <Style x:Key="LeftItemButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftPressedBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A link in the right column, on glass -->
        <Style x:Key="RightItemButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="9,0,6,0">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Effect="{StaticResource GlassTextGlow}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RightHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RightHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Power, lock and options buttons -->
        <Style x:Key="PowerBarButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{StaticResource GlassButtonBackground}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                BorderBrush="#B0000000"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#60FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                <Border x:Name="Glow"
                                        CornerRadius="2"
                                        Background="#00FFFFFF" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#40000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Program row with a large or small icon, depending on the Start menu settings -->
        <DataTemplate x:Key="ProgramTemplate">
            <Button Style="{StaticResource LeftItemButton}"
                    Padding="4,2"
                    MinHeight="{Binding ProgramRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Click="ProgramButton_Click"
                    MouseRightButtonUp="ProgramButton_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Source="{Binding Icon}"
                           Width="{Binding ProgramIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding ProgramIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="0,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="NameText"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="{Binding Subtitle}"
                                   Foreground="#FF6D6D6D"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBold}" Value="True">
                    <Setter TargetName="NameText" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSubtitle}" Value="True">
                    <Setter TargetName="SubtitleText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Search result row with a small icon -->
        <DataTemplate x:Key="ResultTemplate">
            <Button Style="{StaticResource LeftItemButton}"
                    Padding="4,1"
                    MinHeight="22"
                    Click="ProgramButton_Click"
                    MouseRightButtonUp="ProgramButton_MouseRightButtonUp">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}"
                           Width="16"
                           Height="16"
                           Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- All Programs tree -->
        <HierarchicalDataTemplate x:Key="AllProgramsTemplate"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Height="20">
                <Image Source="{Binding Icon}"
                       Width="16"
                       Height="16"
                       Margin="0,0,6,0" />
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="190" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="AllProgramsItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,0"
                                    MouseLeftButtonUp="AllProgramsItem_MouseLeftButtonUp"
                                    MouseRightButtonUp="AllProgramsItem_MouseRightButtonUp">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"
                                            Margin="14,0,0,0"
                                            Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LeftHoverBackground}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LeftHoverBorder}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultsHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF1E3287" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,6,6,2" />
        </Style>

        <Style x:Key="FlatScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Menu body; the top margin leaves room for the user picture, which overhangs the frame as in Vista -->
        <Border x:Name="Frame"
                Margin="0,24,0,0"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="#C0000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource GlassFrameBackground}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter Property="Background" Value="{StaticResource BasicFrameBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Border CornerRadius="5"
                        Background="{StaticResource GlassSheen}"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="252" />
                        <ColumnDefinition Width="148" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left column -->
                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Margin="7,7,0,0"
                            CornerRadius="3"
                            Background="#FFFFFFFF"
                            BorderBrush="#A0000000"
                            BorderThickness="1">
                        <Grid Margin="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Pinned and recent programs. Kept in the layout while hidden so the menu keeps its size. -->
                            <StackPanel x:Name="HomeView"
                                        Grid.Row="0"
                                        MinHeight="416"
                                        KeyboardNavigation.DirectionalNavigation="Contained">
                                <ItemsControl x:Name="PinnedList"
                                              ItemsSource="{Binding PinnedPrograms, ElementName=Root}"
                                              ItemTemplate="{StaticResource ProgramTemplate}"
                                              Focusable="False" />
                                <Border x:Name="PinnedSeparator"
                                        Height="1"
                                        Margin="6,4"
                                        Background="{StaticResource LeftSeparator}" />
                                <ItemsControl x:Name="RecentList"
                                              ItemsSource="{Binding RecentPrograms, ElementName=Root}"
                                              ItemTemplate="{StaticResource ProgramTemplate}"
                                              Focusable="False" />
                            </StackPanel>

                            <ScrollViewer x:Name="AllProgramsView"
                                          Grid.Row="0"
                                          Style="{StaticResource FlatScrollViewer}"
                                          Height="{Binding ActualHeight, ElementName=HomeView}"
                                          Visibility="Collapsed">
                                <TreeView x:Name="AllProgramsTree"
                                          ItemsSource="{Binding AllPrograms, ElementName=Root}"
                                          ItemTemplate="{StaticResource AllProgramsTemplate}"
                                          ItemContainerStyle="{StaticResource AllProgramsItem}"
                                          KeyDown="AllProgramsTree_KeyDown">
                                    <TreeView.Template>
                                        <ControlTemplate TargetType="TreeView">
                                            <ItemsPresenter />
                                        </ControlTemplate>
                                    </TreeView.Template>
                                </TreeView>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SearchView"
                                          Grid.Row="0"
                                          Style="{StaticResource FlatScrollViewer}"
                                          Height="{Binding ActualHeight, ElementName=HomeView}"
                                          Visibility="Collapsed">
                                <StackPanel KeyboardNavigation.DirectionalNavigation="Contained">
                                    <TextBlock x:Name="ProgramsHeader"
                                               Style="{StaticResource ResultsHeader}"
                                               Text="{DynamicResource start_menu_programs_heading}" />
                                    <ItemsControl x:Name="SearchProgramsList"
                                                  ItemsSource="{Binding SearchPrograms, ElementName=Root}"
                                                  ItemTemplate="{StaticResource ResultTemplate}"
                                                  Focusable="False" />
                                    <TextBlock x:Name="FilesHeader"
                                               Style="{StaticResource ResultsHeader}"
                                               Text="{DynamicResource start_menu_files_heading}" />
                                    <ItemsControl x:Name="SearchFilesList"
                                                  ItemsSource="{Binding SearchFiles, ElementName=Root}"
                                                  ItemTemplate="{StaticResource ResultTemplate}"
                                                  Focusable="False" />
                                    <TextBlock x:Name="NoResultsText"
                                               Margin="8,10"
                                               Foreground="#FF6D6D6D"
                                               TextWrapping="Wrap"
                                               Text="{DynamicResource start_menu_no_results}" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="6,4"
                                    Background="{StaticResource LeftSeparator}" />

                            <Button x:Name="AllProgramsButton"
                                    Grid.Row="2"
                                    Style="{StaticResource LeftItemButton}"
                                    Padding="6,0"
                                    Height="26"
                                    Click="AllProgramsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="AllProgramsArrow"
                                          Data="M 0,0 L 4,4 L 0,8 Z"
                                          Fill="#FF2E2E2E"
                                          VerticalAlignment="Center"
                                          Margin="2,0,8,0" />
                                    <TextBlock x:Name="AllProgramsText"
                                               VerticalAlignment="Center"
                                               Text="{DynamicResource start_menu_all_programs}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Right column -->
                    <StackPanel x:Name="RightColumn"
                                Grid.Column="1"
                                Grid.Row="0"
                                Margin="6,46,7,4"
                                KeyboardNavigation.DirectionalNavigation="Contained" />

                    <!-- Search box -->
                    <Border x:Name="SearchBoxBorder"
                            Grid.Column="0"
                            Grid.Row="1"
                            Margin="7,7,0,8"
                            Height="24"
                            CornerRadius="2"
                            Background="#FFFFFFFF"
                            BorderBrush="#FF7A7E84"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="3,0,24,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Margin="6,0,24,0"
                                       VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Foreground="#FF6D6D6D"
                                       IsHitTestVisible="False"
                                       Text="{DynamicResource start_menu_search_placeholder}" />
                            <Path HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Stroke="#FF3F5D8A"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  IsHitTestVisible="False"
                                  Data="M 9.5,9.5 L 13,13 M 6,1 A 5,5 0 1 1 5.99,1 Z" />
                        </Grid>
                    </Border>

                    <!-- Power, lock and more options -->
                    <StackPanel Grid.Column="1"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,7,0,8">
                        <Button x:Name="PowerButton"
                                Style="{StaticResource PowerBarButton}"
                                Background="{StaticResource PowerSleepBackground}"
                                Width="42"
                                Click="PowerButton_Click">
                            <Path Stroke="#FFFFFFFF"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 4.2,3.6 A 6,6 0 1 0 11.8,3.6 M 8,0.5 L 8,7" />
                        </Button>
                        <Button x:Name="LockButton"
                                Style="{StaticResource PowerBarButton}"
                                Width="42"
                                Margin="3,0,0,0"
                                Click="LockButton_Click">
                            <Canvas Width="12" Height="15">
                                <Path Stroke="#FFE6E6E6"
                                      StrokeThickness="1.8"
                                      Data="M 3,7 L 3,4.5 A 3,3 0 0 1 9,4.5 L 9,7" />
                                <Rectangle Canvas.Left="0.5"
                                           Canvas.Top="6.5"
                                           Width="11"
                                           Height="8"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Stroke="#FF6B4A00"
                                           StrokeThickness="1">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFE58A" Offset="0" />
                                            <GradientStop Color="#FFE0A922" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Canvas>
                        </Button>
                        <Button x:Name="PowerOptionsButton"
                                Style="{StaticResource PowerBarButton}"
                                Width="18"
                                Margin="1,0,0,0"
                                Click="PowerOptionsButton_Click">
                            <Path Data="M 0,0 L 4,4 L 0,8 Z"
                                  Fill="#FFFFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- User picture in its frame, overhanging the top of the menu -->
        <Border x:Name="PictureFrame"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,43,0"
                Width="64"
                Height="64"
                CornerRadius="5"
                BorderBrush="#FF5E6B77"
                BorderThickness="1"
                Padding="7">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF7F9FB" Offset="0.0" />
                    <GradientStop Color="#FFD2DAE2" Offset="0.5" />
                    <GradientStop Color="#FFA9B6C2" Offset="0.5" />
                    <GradientStop Color="#FFC8D2DB" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border BorderBrush="#FF46505A"
                    BorderThickness="1"
                    Background="#FFFFFFFF">
                <Image x:Name="UserPicture"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </Border>
    </Grid>
</Window>
