<Window x:Class="RetroBar.StartMenu.UserPictureWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User picture"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="False"
        SourceInitialized="Window_SourceInitialized"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <!--
        The Vista user picture frame. Its outline is not a rounded rectangle but a superellipse ("squircle"):
        every edge bows slightly outward and flows into wide, gradual corners. The shape, exponent and ring
        widths were traced from Windows Vista and Windows 7 screenshots. From the outside in, each ring 1 px
        unless noted, all following the same superellipse:
          outline
          rim: white along the top and left, teal along the right, deep teal along the bottom (lit from the top left)
          glass band (2 px): white along the top, nearly clear down the sides, teal along the bottom
          light line, dark line, then the 46 x 46 picture
        The ring geometry is generated in code (UserPictureWindow.xaml.cs).

        While the pointer is over an item in the right column, Vista shows that item's large icon here instead: the
        icon alone, on a transparent background, with no frame. The frame and picture fade out as the icon fades in
        (FrameLayer, ItemIconA and ItemIconB; ShowItemIcon and ShowPicture in UserPictureWindow.xaml.cs).
    -->
    <Canvas Width="58" Height="58">
        <Canvas x:Name="FrameLayer"
                Width="58"
                Height="58">
            <Path x:Name="OutlineRing">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28000000" Offset="0.0" />
                        <GradientStop Color="#68000000" Offset="0.35" />
                        <GradientStop Color="#8C101414" Offset="0.7" />
                        <GradientStop Color="#D0143A3A" Offset="1.0" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <Path x:Name="RimRing">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.47" />
                        <GradientStop Color="#FFA9D5DA" Offset="0.56" />
                        <GradientStop Color="#FF61A4AC" Offset="0.75" />
                        <GradientStop Color="#FF5B9FA7" Offset="1.0" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <!-- Deepens the rim along the bottom edge -->
            <Path x:Name="RimShade">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000B4B53" Offset="0.0" />
                        <GradientStop Color="#000B4B53" Offset="0.82" />
                        <GradientStop Color="#C00B4B53" Offset="0.94" />
                        <GradientStop Color="#FF0B4B53" Offset="1.0" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <Path x:Name="BandRing">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#F6FFFFFF" Offset="0.1" />
                        <GradientStop Color="#90FFFFFF" Offset="0.3" />
                        <GradientStop Color="#22FFFFFF" Offset="0.48" />
                        <GradientStop Color="#14FFFFFF" Offset="0.82" />
                        <GradientStop Color="#7068AEB5" Offset="0.88" />
                        <GradientStop Color="#E862A6AC" Offset="0.93" />
                        <GradientStop Color="#FF5B9EA3" Offset="1.0" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <!-- Lights the band from the left -->
            <Path x:Name="BandShade">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#30FFFFFF" Offset="0.0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.5" />
                        <GradientStop Color="#08000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <Path x:Name="LightRing" Fill="#FFD9DAE0" />
            <Path x:Name="DarkRing" Fill="#FF5C6068" />

            <Rectangle x:Name="PictureBackground"
                       Canvas.Left="6"
                       Canvas.Top="6"
                       Width="46"
                       Height="46"
                       Fill="#FFFFFFFF" />
            <Image x:Name="Picture"
                   Canvas.Left="6"
                   Canvas.Top="6"
                   Width="46"
                   Height="46"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Canvas>

        <!-- The hovered item's 48 x 48 icon, centred where the frame is; two, so one icon can fade into the next -->
        <Image x:Name="ItemIconA"
               Canvas.Left="5"
               Canvas.Top="5"
               Width="48"
               Height="48"
               Opacity="0"
               Stretch="Uniform"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="ItemIconB"
               Canvas.Left="5"
               Canvas.Top="5"
               Width="48"
               Height="48"
               Opacity="0"
               Stretch="Uniform"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Canvas>
</Window>
